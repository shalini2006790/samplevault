<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b132b"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Processing Details"
            android:textColor="#10b981"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Processing Information:"
        android:textColor="#94a3b8"
        android:layout_marginBottom="16dp" />

    <!-- 1. Processing Date -->
    <EditText
        android:id="@+id/etProcDate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Processing Date (YYYY-MM-DD)"
        android:inputType="date"
        android:background="#1c2541"
        android:textColor="#fff"
        android:textColorHint="#94a3b8"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- 2. Samples Processed -->
    <EditText
        android:id="@+id/etProcCount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Number of Samples Processed"
        android:inputType="number"
        android:background="#1c2541"
        android:textColor="#fff"
        android:textColorHint="#94a3b8"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- 3. Process Conducted -->
    <EditText
        android:id="@+id/etProcConducted"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Process Conducted (+)"
        android:gravity="top"
        android:background="#1c2541"
        android:textColor="#fff"
        android:textColorHint="#94a3b8"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- 4. Storage Conditions -->
    <EditText
        android:id="@+id/etStorageCond"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Storage Conditions"
        android:background="#1c2541"
        android:textColor="#fff"
        android:textColorHint="#94a3b8"
        android:padding="16dp"
        android:layout_marginBottom="32dp"/>

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnSubmitProc"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Save &amp; Proceed to Upload"
        android:backgroundTint="#00f0ff"
        android:textColor="#0b132b"
        android:textStyle="bold" />

</LinearLayout>