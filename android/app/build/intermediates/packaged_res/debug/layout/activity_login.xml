<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="#0b132b">

    <ImageView android:id="@+id/logoImage" android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/logo" android:scaleType="fitCenter" android:layout_marginBottom="16dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SampleVault" android:textColor="#00f0ff" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Secure. Track. Analyze." android:textColor="#94a3b8" android:textSize="14sp" android:layout_marginBottom="32dp" />

    <Spinner android:id="@+id/roleSpinner" android:layout_width="match_parent" android:layout_height="55dp" android:background="#1c2541" android:layout_marginBottom="16dp" />
    <EditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="55dp" android:background="#1c2541" android:hint="Email Address" android:inputType="textEmailAddress" android:textColor="#ffffff" android:textColorHint="#94a3b8" android:padding="16dp" android:layout_marginBottom="16dp" />
    <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="55dp" android:background="#1c2541" android:hint="Password" android:inputType="textPassword" android:textColor="#ffffff" android:textColorHint="#94a3b8" android:padding="16dp" android:layout_marginBottom="32dp" />
    <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="60dp" android:text="Authenticate" android:backgroundTint="#00f0ff" android:textColor="#0b132b" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="16dp" />
    <TextView android:id="@+id/tvRegisterLink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Don't have an account? Register" android:textColor="#00f0ff" android:padding="10dp" android:textSize="14sp" />
</LinearLayout>